{
  "expo": {
    "name": "FASTFOOD Courier",
    "slug": "fastfood-courier",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "fastfoodcourier",
    "platforms": [
      "ios",
      "android"
    ],
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Şubedeki QR teslimat kodunu okutmak için kamera gerekir.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.azemyazilim.fastfoodcourier"
    },
    "ios": {
      "bundleIdentifier": "com.azemyazilim.fastfoodcourier"
    }
  }
}
