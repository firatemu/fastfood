# Copy to .env.local (gitignored). Stitch MCP API key from stitch.withgoogle.com → Settings.
STITCH_API_KEY=
# Dedicated host used by the sandboxed customer address map. Local dev uses
# http://map.localhost:3100; non-local environments must set their own map origin.
NEXT_PUBLIC_STOREFRONT_MAP_FRAME_ORIGIN=http://map.localhost:3100
# OAuth bearer for HTML file download (not the API key):
# STITCH_ACCESS_TOKEN=$(gcloud auth application-default print-access-token)
