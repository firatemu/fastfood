{
  "name": "@fastfood/storefront-web",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Customer-facing Next.js 16 BURGER HOME Storefront wired to the FASTFOOD API.",
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 3100",
    "start": "next start -p 3100",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --passWithNoTests",
    "clean": "rm -rf .next dist .turbo",
    "stitch:auth": "bash scripts/stitch-gcloud-login.sh",
    "stitch:pull": "node scripts/stitch-pull.mjs",
    "stitch:pull:browser": "node scripts/stitch-pull-browser.mjs",
    "stitch:pull:cdp": "node scripts/stitch-pull-cdp.mjs",
    "stitch:sync": "node scripts/stitch-sync-local.mjs",
    "stitch:pull:sdk": "node scripts/stitch-pull-sdk.mjs",
    "stitch:publish": "node scripts/stitch-publish-raw.mjs",
    "stitch:import": "node scripts/stitch-import.mjs"
  },
  "dependencies": {
    "@fastfood/api-client": "workspace:*",
    "@fastfood/config": "workspace:*",
    "@fastfood/contracts": "workspace:*",
    "@fastfood/domain-types": "workspace:*",
    "@tailwindcss/postcss": "4.1.13",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.1.13",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@fastfood/eslint-config": "workspace:*",
    "@fastfood/tsconfig": "workspace:*",
    "@google/stitch-sdk": "^0.3.5",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.0.0",
    "eslint": "9.18.0",
    "eslint-config-next": "16.3.5",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
