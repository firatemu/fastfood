# QR Menü (read-only table menu surface, published on port 3104).
# 3103 is already taken by the containerised Admin instance.

# Server-only. The API CORS allowlist does not include this origin, so all
# catalog traffic happens during server render.
QR_MENU_API_BASE_URL=http://localhost:4000/api/v1

# Seconds the server keeps the catalog snapshot before refetching.
QR_MENU_REVALIDATE_SECONDS=60