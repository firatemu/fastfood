{
  "name": "@fastfood/api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "FASTFOOD backend — NestJS 12 modular monolith on Fastify. Phase 0 foundation only.",
  "type": "module",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/main.js",
    "start:dev": "node --env-file=.env --import tsx --watch src/main.ts",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed-address-geography": "tsx prisma/seed-address-geography.ts",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@fastfood/config": "workspace:*",
    "@fastfood/contracts": "workspace:*",
    "@fastfood/domain-types": "workspace:*",
    "@fastfood/observability": "workspace:*",
    "@fastfood/test-utils": "workspace:*",
    "@fastfood/validation": "workspace:*",
    "@fastify/static": "8.2.0",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-fastify": "12.0.3",
    "@nestjs/swagger": "12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "fastify": "5.2.1",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "uuid": "11.0.5",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@fastfood/eslint-config": "workspace:*",
    "@fastfood/tsconfig": "workspace:*",
    "@nestjs/testing": "12.0.3",
    "@types/node": "22.20.3",
    "@types/pg": "8.11.10",
    "@types/uuid": "10.0.0",
    "pino-pretty": "11.3.0",
    "prisma": "7.10.0",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
