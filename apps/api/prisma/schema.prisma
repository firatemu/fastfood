  @@index([orderId])
  @@map("order_items")
}

model OrderItemModifier {
  id                      String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderItemId             String @map("order_item_id") @db.Uuid
  modifierId              String @map("modifier_id") @db.Uuid
  nameSnapshot            String @map("name_snapshot") @db.VarChar(128)
  priceDeltaMinorSnapshot BigInt @default(0) @map("price_delta_minor_snapshot") @db.BigInt

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

model OrderItemRemoval {
  id           String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderItemId  String @map("order_item_id") @db.Uuid
  ingredientId String @map("ingredient_id") @db.Uuid
  nameSnapshot String @map("name_snapshot") @db.VarChar(128)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_removals")
}

model OrderEvent {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(64)
  fromStatus  String?  @map("from_status") @db.VarChar(32)
  toStatus    String?  @map("to_status") @db.VarChar(32)
  actorUserId String?  @map("actor_user_id") @db.Uuid
  payloadJson Json?    @map("payload_json")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

model OrderBranchAssignment {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  reason     String?  @db.VarChar(255)
  assignedBy String?  @map("assigned_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([branchId])
  @@map("order_branch_assignments")
}

// ─── Notifications foundation (Phase 7) ───

model Notification {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  channel     String    @db.VarChar(32)
  templateKey String    @map("template_key") @db.VarChar(64)
  status      String    @default("PENDING") @db.VarChar(32)
  payloadJson Json?     @map("payload_json")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)
