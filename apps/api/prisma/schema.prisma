model StorefrontComboOfferItem {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  comboOfferId String   @map("combo_offer_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  quantity     Int      @default(1)
