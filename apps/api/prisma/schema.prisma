// FASTFOOD — Canonical Prisma schema.
//
// Document 35 + 16 mandate:
//   - UUIDv7 primary IDs via PostgreSQL 18 `uuidv7()` default
//   - snake_case table/column names with PascalCase models and camelCase props
//   - integer minor-unit money (`BigInt` / PostgreSQL `BIGINT`)
//   - UTC timestamps with snake_case columns (`created_at`, `updated_at`)
//   - PostGIS extension is enabled by the dedicated bootstrap migration
//
// Phase 0 introduced the foundation probe + extensions.
// Phase 3 extends the schema with the canonical identity entities from
// document 31 §"Identity and authorization" + §"Platform":
//   User, StaffProfile, CustomerProfile, Session, Role, Permission,
//   UserRole, UserBranchScope, Address, AuditLog, OutboxEvent,
//   BusinessSetting, plus the FoundationProbe kept for end-to-end
//   UUIDv7/BigInt/UTC pipeline validation.
//
// Catalog / branch / order / loyalty / payment / kitchen / courier /
// delivery / reporting entities are intentionally added in later phases
// per document 23.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  output          = "./generated/client"
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, uuidOssp(map: "uuid-ossp")]
}

// ─── Phase 0 foundation probe (retained for end-to-end pipeline validation) ───
model FoundationProbe {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  label       String   @map("label") @db.VarChar(120)
  amountMinor BigInt   @default(0) @map("amount_minor") @db.BigInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("foundation_probes")
}

// ─── Identity & authorization (Phase 3) ───
//
// `users` is the unified identity table. `actor_type` distinguishes
// staff vs customer vs courier at the database layer. Staff-specific
// (StaffProfile) and customer-specific (CustomerProfile) information
// is split into separate tables to keep the access paths simple and
// to avoid storing courier credentials on a "customer" surface.
//
// Document 31 §"Identity and authorization".

enum ActorType {
  CUSTOMER
  STAFF
  COURIER
  SYSTEM
  GUEST

  @@map("actor_type")
}

enum IdentifierType {
  EMAIL
  PHONE
  STAFF_USERNAME

  @@map("identifier_type")
}

enum AuthProvider {
  PHONE_OTP
  EMAIL_PASSWORD
  GOOGLE
  APPLE

  @@map("auth_provider")
}

enum AccountStatus {
  ACTIVE
  DISABLED
  LOCKED
  PENDING_VERIFICATION

  @@map("account_status")
}

model User {
  id                       String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorType                ActorType       @map("actor_type")
  status                   AccountStatus   @default(PENDING_VERIFICATION)
  primaryIdentifier        String?         @unique @map("primary_identifier") @db.VarChar(255)
  primaryIdentifierType    IdentifierType? @map("primary_identifier_type")
  displayName              String?         @map("display_name") @db.VarChar(120)
  customPermissionsEnabled Boolean         @default(false) @map("custom_permissions_enabled")
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  disabledAt               DateTime?       @map("disabled_at") @db.Timestamptz(6)

  staffProfile                  StaffProfile?
  customerProfile               CustomerProfile?
  sessions                      Session[]
  userRoles                     UserRole[]
  userPermissionGrants          UserPermissionGrant[]        @relation("UserPermissionGrants")
  issuedPermissionGrants        UserPermissionGrant[]        @relation("PermissionGrantActor")
  userBranchScopes              UserBranchScope[]
  branchAdministrator           BranchAdministrator?         @relation("BranchAdministrator")
  appointedBranchAdministrators BranchAdministrator[]        @relation("BranchAdministratorActor")
  addresses                     Address[]
  outboxEvents                  OutboxEvent[]                @relation("OutboxCreator")
  customerCredential            CustomerCredential?
  authIdentities                AuthIdentity[]
  emailVerificationChallenges   EmailVerificationChallenge[]
  passwordResetChallenges       PasswordResetChallenge[]
  customerPreference            CustomerPreference?
  favorites                     CustomerFavorite[]
  welcomeRewardGrants           WelcomeRewardGrant[]
  spinPlays                     SpinPlay[]
  supportConversations          SupportConversation[]
  diningTableScans              DiningTableScan[]

  @@index([actorType])
  @@index([status])
  @@map("users")
}

model StaffProfile {
  userId               String    @id @map("user_id") @db.Uuid
  passwordHash         String?   @map("password_hash") @db.VarChar(255)
  passwordAlgo         String?   @map("password_algo") @db.VarChar(32)
  passwordUpdatedAt    DateTime? @map("password_updated_at") @db.Timestamptz(6)
  mfaEnabled           Boolean   @default(false) @map("mfa_enabled")
  mfaSecretEnc         String?   @map("mfa_secret_enc") @db.VarChar(512)
  mfaRecoveryCodesHash String?   @map("mfa_recovery_codes_hash") @db.VarChar(1024)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_profiles")
}

model CustomerProfile {
  userId          String    @id @map("user_id") @db.Uuid
  phoneNormalized String?   @unique @map("phone_normalized") @db.VarChar(32)
  phoneVerified   Boolean   @default(false) @map("phone_verified")
  emailNormalized String?   @unique @map("email_normalized") @db.VarChar(255)
  emailVerified   Boolean   @default(false) @map("email_verified")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  locale          String?   @map("locale") @db.VarChar(16)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model CustomerCredential {
  userId            String   @id @map("user_id") @db.Uuid
  passwordHash      String   @map("password_hash") @db.VarChar(255)
  passwordAlgo      String   @map("password_algo") @db.VarChar(32)
  passwordUpdatedAt DateTime @map("password_updated_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_credentials")
}

model AuthIdentity {
  id                      String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                  String       @map("user_id") @db.Uuid
  provider                AuthProvider
  providerSubject         String       @map("provider_subject") @db.VarChar(255)
  emailNormalized         String?      @map("email_normalized") @db.VarChar(255)
  emailVerifiedByProvider Boolean      @default(false) @map("email_verified_by_provider")
  linkedAt                DateTime     @default(now()) @map("linked_at") @db.Timestamptz(6)
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

model EmailVerificationChallenge {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  emailNormalized String    @map("email_normalized") @db.VarChar(255)
  tokenHash       String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt      DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_challenges")
}

model PasswordResetChallenge {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_challenges")
}

model CustomerPreference {
  userId            String    @id @map("user_id") @db.Uuid
  marketingOptIn    Boolean   @default(false) @map("marketing_opt_in")
  newsletterOptIn   Boolean   @default(false) @map("newsletter_opt_in")
  orderUpdatesOptIn Boolean   @default(true) @map("order_updates_opt_in")
  kvkkAcceptedAt    DateTime? @map("kvkk_accepted_at") @db.Timestamptz(6)
  locale            String?   @db.VarChar(16)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_preferences")
}

model Session {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(128)
  familyId         String    @map("family_id") @db.Uuid
  issuedAt         DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason    String?   @map("revoked_reason") @db.VarChar(64)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

model Role {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code        String   @unique @db.VarChar(64)
  name        String   @map("name") @db.VarChar(120)
  description String?  @db.VarChar(512)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code        String   @unique @db.VarChar(128)
  description String?  @db.VarChar(512)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions      RolePermission[]
  userPermissionGrants UserPermissionGrant[]

  @@map("permissions")
}

model UserPermissionGrant {
  userId          String   @map("user_id") @db.Uuid
  permissionId    String   @map("permission_id") @db.Uuid
  grantedByUserId String?  @map("granted_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User       @relation("UserPermissionGrants", fields: [userId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedByUser User?      @relation("PermissionGrantActor", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, permissionId])
  @@index([permissionId])
  @@map("user_permission_grants")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId          String    @map("user_id") @db.Uuid
  roleId          String    @map("role_id") @db.Uuid
  grantedByUserId String?   @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model UserBranchScope {
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  scopeKind String   @map("scope_kind") @db.VarChar(32) // "assigned" | "global" | "own"
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@unique([userId])
  @@index([branchId])
  @@map("user_branch_scopes")
}

// ─── Address (Phase 3 — coordinate persistence only) ───
//
// Document 07 §7-§8 + 31 §"Customer/address". Phase 3 persists
// coordinates + ownership. Serviceability decision (whether a
// given address can be delivered to by a branch) is deferred to
// Phase 4 per the roadmap.

model Address {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  label           String?  @map("label") @db.VarChar(64)
  recipientName   String   @map("recipient_name") @db.VarChar(120)
  recipientPhone  String   @map("recipient_phone") @db.VarChar(32)
  latitude        Decimal  @map("latitude") @db.Decimal(9, 6)
  longitude       Decimal  @map("longitude") @db.Decimal(9, 6)
  countryCode     String   @map("country_code") @db.VarChar(2)
  provinceId      Int?     @map("province_id") @db.SmallInt
  districtId      Int?     @map("district_id")
  neighborhoodId  Int?     @map("neighborhood_id")
  province        String?  @map("province") @db.VarChar(64)
  city            String?  @map("city") @db.VarChar(64)
  district        String?  @map("district") @db.VarChar(64)
  neighborhood    String?  @map("neighborhood") @db.VarChar(128)
  avenue          String?  @map("avenue") @db.VarChar(255)
  street          String?  @map("street") @db.VarChar(255)
  buildingNumber  String?  @map("building_number") @db.VarChar(32)
  floor           String?  @map("floor") @db.VarChar(32)
  apartmentNumber String?  @map("apartment_number") @db.VarChar(32)
  floorApartment  String?  @map("floor_apartment") @db.VarChar(64)
  accessCode      String?  @map("access_code") @db.VarChar(64)
  deliveryNote    String?  @map("delivery_note") @db.VarChar(512)
  providerPlaceId String?  @map("provider_place_id") @db.VarChar(255)
  normalizedText  String?  @map("normalized_text") @db.VarChar(1024)
  isDefault       Boolean  @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  provinceReference     AddressProvince?     @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  districtReference     AddressDistrict?     @relation(fields: [districtId, provinceId], references: [id, provinceId], onDelete: Restrict)
  neighborhoodReference AddressNeighborhood? @relation(fields: [neighborhoodId, districtId], references: [id, districtId], onDelete: Restrict)

  @@index([userId])
  @@map("addresses")
}

// Customer address selectors use a bounded, locally seeded set of official
// province/district/neighborhood reference identifiers.
model AddressProvince {
  id              Int               @id @db.SmallInt
  name            String            @unique @db.VarChar(64)
  displayOrder    Int               @map("display_order") @db.SmallInt
  centerLatitude  Decimal           @map("center_latitude") @db.Decimal(9, 6)
  centerLongitude Decimal           @map("center_longitude") @db.Decimal(9, 6)
  districts       AddressDistrict[]
  addresses       Address[]

  @@map("address_provinces")
}

model AddressDistrict {
  id            Int                   @id
  provinceId    Int                   @map("province_id") @db.SmallInt
  name          String                @db.VarChar(128)
  postalCode    String?               @map("postal_code") @db.VarChar(16)
  province      AddressProvince       @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  neighborhoods AddressNeighborhood[]
  addresses     Address[]

  @@unique([id, provinceId])
  @@unique([provinceId, name])
  @@index([provinceId])
  @@map("address_districts")
}

model AddressNeighborhood {
  id         Int             @id
  districtId Int             @map("district_id")
  name       String          @db.VarChar(128)
  postalCode String?         @map("postal_code") @db.VarChar(16)
  district   AddressDistrict @relation(fields: [districtId], references: [id], onDelete: Restrict)
  addresses  Address[]

  @@unique([id, districtId])
  @@index([districtId])
  @@map("address_neighborhoods")
}

// ─── AuditLog (Phase 3) ───
//
// Document 18 §8 + 31 §"Platform". Append-only. Updates / deletes are
// rejected at the application layer (the application never exposes
// a mutation for this table).
model AuditLog {
  id              String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorUserId     String?    @map("actor_user_id") @db.Uuid
  actorType       ActorType? @map("actor_type")
  action          String     @map("action") @db.VarChar(128)
  resourceType    String     @map("resource_type") @db.VarChar(64)
  resourceId      String?    @map("resource_id") @db.Uuid
  branchId        String?    @map("branch_id") @db.Uuid
  requestId       String?    @map("request_id") @db.Uuid
  correlationId   String?    @map("correlation_id") @db.Uuid
  priorValuesJson Json?      @map("prior_values_json") @db.JsonB
  newValuesJson   Json?      @map("new_values_json") @db.JsonB
  reason          String?    @map("reason") @db.VarChar(512)
  ipAddress       String?    @map("ip_address") @db.VarChar(64)
  userAgent       String?    @map("user_agent") @db.VarChar(512)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorUserId])
  @@index([resourceType, resourceId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── OutboxEvent (Phase 3 — transactional outbox pattern) ───
//
// Document 17 §4 + 31 §"OutboxEvent". The application writes the
// business mutation + the OutboxEvent row in a single
// `PrismaService.$transaction([...])` call. A separate worker (out
// of scope for Phase 3) consumes published events and dispatches
// them to BullMQ / external providers.
model OutboxEvent {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventType       String    @map("event_type") @db.VarChar(128)
  eventVersion    Int       @default(1) @map("event_version")
  aggregateType   String?   @map("aggregate_type") @db.VarChar(64)
  aggregateId     String?   @map("aggregate_id") @db.Uuid
  payloadJson     Json      @map("payload_json") @db.JsonB
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  attempts        Int       @default(0) @map("attempts")
  lastAttemptAt   DateTime? @map("last_attempt_at") @db.Timestamptz(6)
  lastError       String?   @map("last_error") @db.VarChar(2048)

  createdByUser User? @relation("OutboxCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([eventType])
  @@index([publishedAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

// ─── BusinessSetting (Phase 3) ───
//
// Document 31 §"Platform" + 36 §"Configuration categories".
// Typed mutable business configuration that may be changed by an
// authorized HQ user. Values are stored as JSONB to remain flexible
// per key while preserving the typed `valueType` discriminator.
model BusinessSetting {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key             String   @unique @db.VarChar(128)
  valueType       String   @map("value_type") @db.VarChar(32)
  valueJson       Json     @map("value_json") @db.JsonB
  category        String   @map("category") @db.VarChar(64)
  description     String?  @db.VarChar(512)
  mutable         Boolean  @default(true) @map("mutable")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid

  @@index([category])
  @@map("business_settings")
}

// ─── Catalog (Phase 4) ───
//
// Document 08 + 31 §"Catalog".
// Categories form a tree via `parentCategoryId`. Products are owned
// by HQ (central catalog) and may be hidden at a branch via
// `BranchProductAvailability`.
model Category {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  parentCategoryId String?  @map("parent_category_id") @db.Uuid
  slug             String   @unique @db.VarChar(128)
  name             String   @map("name") @db.VarChar(128)
  description      String?  @db.VarChar(1024)
  displayOrder     Int      @default(0) @map("display_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parentCategory Category?  @relation("CategoryTree", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  children       Category[] @relation("CategoryTree")
  products       Product[]

  @@index([parentCategoryId])
  @@index([slug])
  @@map("categories")
}

model Allergen {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code        String   @unique @db.VarChar(64)
  name        String   @map("name") @db.VarChar(128)
  description String?  @db.VarChar(512)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products ProductAllergen[]

  @@map("allergens")
}

model Product {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  slug           String   @unique @db.VarChar(128)
  name           String   @map("name") @db.VarChar(128)
  description    String?  @db.VarChar(2048)
  basePriceMinor BigInt   @map("base_price_minor") @db.BigInt
  currency       String   @default("TRY") @db.VarChar(3)
  displayOrder   Int      @default(0) @map("display_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

