  name             String    @db.VarChar(128)
  description      String?   @db.VarChar(2048)
  imageUrl         String?   @map("image_url") @db.VarChar(2048)
  bundlePriceMinor BigInt    @map("bundle_price_minor") @db.BigInt
  compareAtMinor   BigInt?   @map("compare_at_minor") @db.BigInt
  currency         String    @default("TRY") @db.VarChar(3)
  endsAt           DateTime? @map("ends_at") @db.Timestamptz(6)
  isActive         Boolean   @default(true) @map("is_active")
  displayOrder     Int       @default(0) @map("display_order")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  items StorefrontComboOfferItem[]

  @@index([isActive, displayOrder])
  @@map("storefront_combo_offers")
