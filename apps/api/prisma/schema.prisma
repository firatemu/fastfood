// ─── Branch (Phase 4) ───
//
// Document 13 + 31 §"Branch/geography". ServiceArea stores a
// GeoJSON MultiPolygon; routing engine (P4-005) uses these polygons
// to assign customer coordinates to a branch. PostGIS extension is
// enabled by the Phase 0 migration.
model Branch {
  id                          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code                        String   @unique @db.VarChar(32)
  name                        String   @map("name") @db.VarChar(128)
  addressLine                 String   @map("address_line") @db.VarChar(255)
  latitude                    Decimal  @map("latitude") @db.Decimal(9, 6)
  longitude                   Decimal  @map("longitude") @db.Decimal(9, 6)
  phone                       String?  @map("phone") @db.VarChar(32)
  isActive                    Boolean  @default(true) @map("is_active")
  isAcceptingOrders           Boolean  @default(true) @map("is_accepting_orders")
  minOrderMinor               BigInt   @default(0) @map("min_order_minor") @db.BigInt
  deliveryFeeMinor            BigInt   @default(0) @map("delivery_fee_minor") @db.BigInt
  estimatedDeliveryMinutesMin Int      @default(0) @map("estimated_delivery_minutes_min")
  estimatedDeliveryMinutesMax Int      @default(0) @map("estimated_delivery_minutes_max")
  storyBody                   String?  @map("story_body") @db.Text
  imageUrl                    String?  @map("image_url") @db.VarChar(2048)
  pickupEnabled               Boolean  @default(true) @map("pickup_enabled")
  deliveryEnabled             Boolean  @default(true) @map("delivery_enabled")
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  operatingHours      BranchOperatingHours[]
  serviceAreas        ServiceArea[]
  productAvailability BranchProductAvailability[]
  diningTables        DiningTable[]
  userBranchScopes    UserBranchScope[]
  administrator       BranchAdministrator?

  @@index([code])
  @@map("branches")
}

model BranchAdministrator {
  branchId         String   @id @map("branch_id") @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  assignedByUserId String   @map("assigned_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch         Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user           User   @relation("BranchAdministrator", fields: [userId], references: [id], onDelete: Restrict)
  assignedByUser User   @relation("BranchAdministratorActor", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@index([assignedByUserId])
  @@map("branch_administrators")
}

model BranchOperatingHours {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  dayOfWeek   Int      @map("day_of_week")
  opensAt     DateTime @map("opens_at") @db.Timestamptz(6)
  closesAt    DateTime @map("closes_at") @db.Timestamptz(6)
  isClosed    Boolean  @default(false) @map("is_closed")
  specialNote String?  @map("special_note") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
  @@index([branchId])
  @@map("branch_operating_hours")
}

model ServiceArea {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  name           String   @map("name") @db.VarChar(128)
  // GeoJSON MultiPolygon in EPSG:4326. The Phase 4 routing engine
  // uses these polygons via an in-memory point-in-polygon check.
  // Production deployment with PostGIS spatial index uses the
  // geometry column directly.
  polygonGeoJson Json     @map("polygon_geojson") @db.JsonB
  priority       Int      @default(0) @map("priority")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@map("service_areas")
}

model BranchProductAvailability {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  isAvailable Boolean  @default(true) @map("is_available")
  reason      String?  @map("reason") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([productId])
  @@map("branch_product_availability")
}

// ─── Cart (Phase 5) ───
//
// Document 09 + 31 §"Checkout/payment" + 16 + 35. Cart is
// server-side session-scoped. Guest carts use a cookie-derived
// session id; customer carts are linked to the authenticated user.
// On customer login the guest cart merges into the customer cart
// (document 09 §3).
//
// Money-bearing columns are BIGINT per document 35 §5.
model Cart {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  guestSessionId String?   @unique @map("guest_session_id") @db.VarChar(64)
  status         String    @default("OPEN") @db.VarChar(16)
  branchId       String?   @map("branch_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)

  lineItems CartLineItem[]

  @@index([userId])
  @@index([status])
  @@map("carts")
}

model CartLineItem {
  id                     String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  cartId                 String   @map("cart_id") @db.Uuid
  productId              String   @map("product_id") @db.Uuid
  productVariantId       String?  @map("product_variant_id") @db.Uuid
  quantity               Int      @map("quantity")
  unitPriceMinorSnapshot BigInt   @map("unit_price_minor_snapshot") @db.BigInt
  currencySnapshot       String   @default("TRY") @map("currency_snapshot") @db.VarChar(3)
  deliveryNote           String?  @map("delivery_note") @db.VarChar(512)
  displayOrder           Int      @default(0) @map("display_order")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart      Cart               @relation(fields: [cartId], references: [id], onDelete: Cascade)
  modifiers CartLineModifier[]
  removals  CartLineRemoval[]

  @@index([cartId])
  @@index([productId])
  @@map("cart_line_items")
}

model CartLineModifier {
  id                      String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  cartLineItemId          String   @map("cart_line_item_id") @db.Uuid
  modifierId              String   @map("modifier_id") @db.Uuid
  priceDeltaMinorSnapshot BigInt   @default(0) @map("price_delta_minor_snapshot") @db.BigInt
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cartLineItem CartLineItem @relation(fields: [cartLineItemId], references: [id], onDelete: Cascade)

  @@unique([cartLineItemId, modifierId])
  @@index([cartLineItemId])
  @@map("cart_line_modifiers")
}

model CartLineRemoval {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  cartLineItemId String   @map("cart_line_item_id") @db.Uuid
  ingredientId   String   @map("ingredient_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cartLineItem CartLineItem @relation(fields: [cartLineItemId], references: [id], onDelete: Cascade)

  @@unique([cartLineItemId, ingredientId])
  @@index([cartLineItemId])
  @@map("cart_line_removals")
}

// ─── Checkout / Payment (Phase 6) ───
//
// Document 31 §Checkout/payment + 09 + 37. Money columns are BIGINT.

model CheckoutSession {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                String?   @map("user_id") @db.Uuid
  guestSessionId        String?   @map("guest_session_id") @db.VarChar(64)
  cartId                String?   @map("cart_id") @db.Uuid
  branchId              String?   @map("branch_id") @db.Uuid
  status                String    @default("OPEN") @db.VarChar(32)
  currency              String    @default("TRY") @db.VarChar(3)
  merchandiseGrossMinor BigInt    @default(0) @map("merchandise_gross_minor") @db.BigInt
  merchandiseNetMinor   BigInt    @default(0) @map("merchandise_net_minor") @db.BigInt
  deliveryFeeMinor      BigInt    @default(0) @map("delivery_fee_minor") @db.BigInt
  loyaltyRedeemedMinor  BigInt    @default(0) @map("loyalty_redeemed_minor") @db.BigInt
  finalPayableMinor     BigInt    @default(0) @map("final_payable_minor") @db.BigInt
  fulfillmentMode       String    @default("DELIVERY") @map("fulfillment_mode") @db.VarChar(16)
  scheduledFor          DateTime? @map("scheduled_for") @db.Timestamptz(6)
  tipMinor              BigInt    @default(0) @map("tip_minor") @db.BigInt
  pickupDiscountMinor   BigInt    @default(0) @map("pickup_discount_minor") @db.BigInt
  ecoPackaging          Boolean   @default(false) @map("eco_packaging")
  contactless           Boolean   @default(false)
  buildingAccessCode    String?   @map("building_access_code") @db.VarChar(64)
  deliveryNote          String?   @map("delivery_note") @db.VarChar(512)
  paymentMethodCode     String?   @map("payment_method_code") @db.VarChar(32)
  guestName             String?   @map("guest_name") @db.VarChar(120)
  guestPhone            String?   @map("guest_phone") @db.VarChar(32)
  orderId               String?   @unique @map("order_id") @db.Uuid
  quoteSnapshotJson     Json?     @map("quote_snapshot_json")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  expiresAt             DateTime? @map("expires_at") @db.Timestamptz(6)

  paymentAttempts PaymentAttempt[]

  @@index([userId])
  @@index([status])
  @@map("checkout_sessions")
}

model PaymentAttempt {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  checkoutSessionId  String   @map("checkout_session_id") @db.Uuid
  provider           String   @default("iyzico") @db.VarChar(32)
  providerPaymentId  String?  @map("provider_payment_id") @db.VarChar(128)
  status             String   @default("INITIATED") @db.VarChar(32)
  amountMinor        BigInt   @map("amount_minor") @db.BigInt
  currency           String   @default("TRY") @db.VarChar(3)
  idempotencyKey     String   @unique @map("idempotency_key") @db.VarChar(128)
  failureCode        String?  @map("failure_code") @db.VarChar(64)
  rawProviderPayload Json?    @map("raw_provider_payload")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  checkoutSession CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  refunds         Refund[]

  @@index([checkoutSessionId])
  @@index([status])
  @@map("payment_attempts")
}

// ─── Refund (final-acceptance persistence remediation) ───
//
// Document 09 + 31 §Checkout/payment. Full and partial refunds
// against a paid PaymentAttempt. Remaining refundable balance is
// enforced at the application layer.
model Refund {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  paymentId   String   @map("payment_id") @db.Uuid
  orderId     String?  @map("order_id") @db.Uuid
  amountMinor BigInt   @map("amount_minor") @db.BigInt
  currency    String   @default("TRY") @db.VarChar(3)
  status      String   @default("PENDING") @db.VarChar(32)
  reason      String?  @db.VarChar(512)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment PaymentAttempt @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([orderId])
  @@index([status])
  @@map("refunds")
}

model IdempotencyRecord {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  scope          String    @db.VarChar(64)
  idempotencyKey String    @map("idempotency_key") @db.VarChar(128)
  requestHash    String?   @map("request_hash") @db.VarChar(128)
  responseJson   Json?     @map("response_json")
  statusCode     Int?      @map("status_code")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
