  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ─── Courier / delivery (Phase 8) ───

model CourierProfile {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  displayName         String   @map("display_name") @db.VarChar(128)
  phone               String?  @db.VarChar(32)
  isActive            Boolean  @default(true) @map("is_active")
  maxActiveDeliveries Int      @default(3) @map("max_active_deliveries")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  deliveries     Delivery[]
  assignments    DeliveryAssignment[]
  locationPoints CourierLocationPoint[]

  @@map("courier_profiles")
}

model Delivery {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId        String    @unique @map("order_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  courierId      String?   @map("courier_id") @db.Uuid
  status         String    @default("UNASSIGNED") @db.VarChar(32)
  recipientName  String?   @map("recipient_name") @db.VarChar(128)
  recipientPhone String?   @map("recipient_phone") @db.VarChar(32)
  addressLine    String?   @map("address_line") @db.VarChar(255)
  latitude       Float?
  longitude      Float?
  deliveryNote   String?   @map("delivery_note") @db.VarChar(512)
  pickedUpAt     DateTime? @map("picked_up_at") @db.Timestamptz(6)
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  courier        CourierProfile?        @relation(fields: [courierId], references: [id])
  assignments    DeliveryAssignment[]
  qrTokens       QrClaimToken[]
  locationPoints CourierLocationPoint[]

  @@index([branchId, status])
  @@index([courierId, status])
  @@map("deliveries")
}

model DeliveryAssignment {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deliveryId String   @map("delivery_id") @db.Uuid
  courierId  String   @map("courier_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  reason     String?  @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  delivery Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  courier  CourierProfile @relation(fields: [courierId], references: [id])

  @@index([deliveryId])
  @@index([courierId])
  @@map("delivery_assignments")
}

model QrClaimToken {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deliveryId         String    @map("delivery_id") @db.Uuid
  tokenHash          String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  claimedAt          DateTime? @map("claimed_at") @db.Timestamptz(6)
  claimedByCourierId String?   @map("claimed_by_courier_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@map("qr_claim_tokens")
}

model CourierLocationPoint {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  courierId  String   @map("courier_id") @db.Uuid
  deliveryId String   @map("delivery_id") @db.Uuid
  latitude   Float
  longitude  Float
  accuracyM  Float?   @map("accuracy_m")
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  courier  CourierProfile @relation(fields: [courierId], references: [id])
  delivery Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([courierId, recordedAt])
  @@index([deliveryId, recordedAt])
  @@map("courier_location_points")
}

// ─── Promotions (Wave 0) ───
//
// Document 11 + 31 §"Promotions". V1 supports coupon/cart discounts with
// usage limits and optional branch scoping.

enum PromotionKind {
  FIXED_CART_MINOR
  PERCENT_CART
  DELIVERY_FEE_WAIVER

  @@map("promotion_kind")
}

model Promotion {
  id                    String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code                  String?       @unique @db.VarChar(64)
  name                  String        @map("name") @db.VarChar(128)
  kind                  PromotionKind @map("kind")
  discountMinor         BigInt?       @map("discount_minor") @db.BigInt
  discountPercentBps    Int?          @map("discount_percent_bps")
  minMerchandiseMinor   BigInt        @default(0) @map("min_merchandise_minor") @db.BigInt
  validFrom             DateTime?     @map("valid_from") @db.Timestamptz(6)
  validTo               DateTime?     @map("valid_to") @db.Timestamptz(6)
  branchIdsJson         Json?         @map("branch_ids_json") @db.JsonB
  usageLimitTotal       Int?          @map("usage_limit_total")
  usageLimitPerCustomer Int?          @map("usage_limit_per_customer")
  combinable            Boolean       @default(false) @map("combinable")
  firstOrderOnly        Boolean       @default(false) @map("first_order_only")
  listedOnStorefront    Boolean       @default(false) @map("listed_on_storefront")
  customerHeadline      String?       @map("customer_headline") @db.VarChar(128)
  customerDescription   String?       @map("customer_description") @db.VarChar(512)
  isActive              Boolean       @default(true) @map("is_active")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  redemptions   CouponRedemption[]
  welcomeGrants WelcomeRewardGrant[]

  @@index([isActive])
  @@map("promotions")
}

model CouponRedemption {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  promotionId String   @map("promotion_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  orderId     String?  @map("order_id") @db.Uuid
  redeemedAt  DateTime @default(now()) @map("redeemed_at") @db.Timestamptz(6)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([userId])
  @@map("coupon_redemptions")
}

// ─── Storefront merchandising (Golden Home / BURGER HOME vitrine) ───
//
// Public customer catalog presentation. Admin writes stay on existing
// catalog admin surfaces; Storefront reads this via GET /storefront/home.

model ProductMerchandising {
  productId        String   @id @map("product_id") @db.Uuid
  isFeatured       Boolean  @default(false) @map("is_featured")
  isHero           Boolean  @default(false) @map("is_hero")
  heroDisplayOrder Int      @default(0) @map("hero_display_order")
  isBuilderBase    Boolean  @default(false) @map("is_builder_base")
  kcal             Int?
  proteinGrams     Int?     @map("protein_grams")
  weightGrams      Int?     @map("weight_grams")
  volumeMl         Int?     @map("volume_ml")
  spiceLevel       Int?     @map("spice_level")
  badge            String?  @db.VarChar(32)
  accentLabel      String?  @map("accent_label") @db.VarChar(64)
  eyebrow          String?  @db.VarChar(128)
  heroDescription  String?  @map("hero_description") @db.VarChar(2048)
  heroImageUrl     String?  @map("hero_image_url") @db.VarChar(2048)
  soldCount        Int      @default(0) @map("sold_count")
  averageRatingBps Int?     @map("average_rating_bps")
  ratingCount      Int      @default(0) @map("rating_count")
  heroSpecJson     Json?    @map("hero_spec_json") @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([isFeatured])
  @@index([isHero, heroDisplayOrder])
  @@index([isBuilderBase])
  @@map("product_merchandising")
}

model StorefrontContentDocument {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug         String    @unique @db.VarChar(64)
  kind         String    @db.VarChar(32)
  title        String    @db.VarChar(128)
  body         String    @db.Text
  sectionsJson Json?     @map("sections_json") @db.JsonB
  effectiveAt  DateTime? @map("effective_at") @db.Timestamptz(6)
  isPublished  Boolean   @default(true) @map("is_published")
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([kind, isPublished, displayOrder])
  @@map("storefront_content_documents")
}

model StorefrontComboOffer {
