model StorefrontPublishedReview {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  authorDisplayName String   @map("author_display_name") @db.VarChar(64)
  body              String   @db.VarChar(2048)
  rating            Int
  branchLabel       String?  @map("branch_label") @db.VarChar(128)
  isPublished       Boolean  @default(true) @map("is_published")
  publishedAt       DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  displayOrder      Int      @default(0) @map("display_order")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isPublished, displayOrder])
  @@map("storefront_published_reviews")
}

model StorefrontSocialProof {
  id                 String   @id @db.Uuid
  averageRatingBps   Int      @map("average_rating_bps")
  happyCustomerCount Int      @map("happy_customer_count")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("storefront_social_proof")
}

model NewsletterSubscription {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email          String    @unique @db.VarChar(255)
  source         String    @default("ember_club") @db.VarChar(64)
  userId         String?   @map("user_id") @db.Uuid
  unsubscribedAt DateTime? @map("unsubscribed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([source])
  @@map("newsletter_subscriptions")
}

model CustomerFavorite {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("customer_favorites")
}

// ─── Storefront Phase 6 — Club, gamification, dine-in, support ───

model LoyaltyTier {
  id                      String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code                    String   @unique @db.VarChar(32)
  displayName             String   @map("display_name") @db.VarChar(64)
  minLifetimeEarnedPoints BigInt   @map("min_lifetime_earned_points") @db.BigInt
  sortOrder               Int      @map("sort_order")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder])
  @@map("loyalty_tiers")
}

model WelcomeRewardGrant {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String    @unique @map("user_id") @db.Uuid
  promotionId   String    @map("promotion_id") @db.Uuid
  pointsGranted BigInt    @default(0) @map("points_granted") @db.BigInt
  grantedAt     DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)

  @@index([promotionId])
  @@map("welcome_reward_grants")
}

model SpinCampaign {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code           String   @unique @db.VarChar(64)
  name           String   @db.VarChar(128)
  startsAt       DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime @map("ends_at") @db.Timestamptz(6)
  isActive       Boolean  @default(true) @map("is_active")
  dailySpinLimit Int      @default(1) @map("daily_spin_limit")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  prizes SpinPrize[]
  plays  SpinPlay[]

  @@index([isActive, startsAt, endsAt])
  @@map("spin_campaigns")
}

model SpinPrize {
  id                 String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  campaignId         String  @map("campaign_id") @db.Uuid
  code               String  @db.VarChar(32)
  label              String  @db.VarChar(128)
  kind               String  @db.VarChar(32)
  weight             Int
  pointsDelta        BigInt? @map("points_delta") @db.BigInt
  discountMinor      BigInt? @map("discount_minor") @db.BigInt
  discountPercentBps Int?    @map("discount_percent_bps")
  sortOrder          Int     @default(0) @map("sort_order")
  isActive           Boolean @default(true) @map("is_active")

  campaign SpinCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  plays    SpinPlay[]

  @@unique([campaignId, code])
  @@index([campaignId, isActive])
  @@map("spin_prizes")
}

model SpinPlay {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  campaignId     String   @map("campaign_id") @db.Uuid
  prizeId        String   @map("prize_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  periodKey      String   @map("period_key") @db.VarChar(16)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(128)
  couponCode     String?  @map("coupon_code") @db.VarChar(64)
  promotionId    String?  @map("promotion_id") @db.Uuid
  pointsAwarded  BigInt   @default(0) @map("points_awarded") @db.BigInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  campaign SpinCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  prize    SpinPrize    @relation(fields: [prizeId], references: [id], onDelete: Restrict)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId, periodKey])
  @@unique([userId, idempotencyKey])
  @@index([campaignId, createdAt])
  @@map("spin_plays")
}

model DiningTable {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  label      String   @db.VarChar(64)
  publicCode String   @unique @map("public_code") @db.VarChar(64)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  scans  DiningTableScan[]

  @@index([branchId, isActive])
  @@map("dining_tables")
}

model DiningTableScan {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tableId        String   @map("table_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  guestSessionId String?  @map("guest_session_id") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  table DiningTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tableId, createdAt])
  @@map("dining_table_scans")
}

model SupportConversation {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  orderId   String?   @map("order_id") @db.Uuid
  status    String    @default("OPEN") @db.VarChar(16)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  closedAt  DateTime? @map("closed_at") @db.Timestamptz(6)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId, status])
  @@index([orderId])
  @@map("support_conversations")
}

model SupportMessage {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  conversationId  String   @map("conversation_id") @db.Uuid
  senderType      String   @map("sender_type") @db.VarChar(16)
  body            String   @db.VarChar(2000)
  clientRequestId String?  @map("client_request_id") @db.VarChar(128)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, clientRequestId])
  @@index([conversationId, createdAt])
  @@map("support_messages")
}
