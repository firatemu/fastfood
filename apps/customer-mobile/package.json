{
  "name": "@fastfood/customer-mobile",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "BURGER HOME customer iOS + Android app. Expo SDK 57 / React Native 0.86. Visual rebuild from Mobile Stitch; APIs shared with the completed Web Storefront.",
  "main": "expo-router/entry",
  "scripts": {
    "build": "echo \"customer-mobile: build is performed by `npx expo prebuild` + native toolchain\" && exit 0",
    "dev": "expo start --port 8081",
    "start": "expo start --port 8081",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --passWithNoTests",
    "clean": "rm -rf .expo dist .turbo"
  },
  "dependencies": {
    "@expo-google-fonts/anton": "0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "0.4.2",
    "@expo/vector-icons": "15.1.1",
    "@fastfood/api-client": "workspace:*",
    "@fastfood/config": "workspace:*",
    "@fastfood/contracts": "workspace:*",
    "@fastfood/domain-types": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.21",
    "expo-blur": "57.0.3",
    "expo-camera": "57.0.5",
    "expo-clipboard": "^57.0.2",
    "expo-constants": "57.0.19",
    "expo-font": "57.0.4",
    "expo-image": "57.0.5",
    "expo-linear-gradient": "57.0.2",
    "expo-location": "~57.0.20",
    "expo-router": "57.0.22",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "3.0.9",
    "expo-system-ui": "57.0.4",
    "react": "19.3.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.9.1",
    "react-native-screens": "4.26.2",
    "react-native-webview": "13.16.1",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@fastfood/eslint-config": "workspace:*",
    "@fastfood/tsconfig": "workspace:*",
    "@types/react": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
