{
  "name": "fastfood",
  "version": "0.0.0",
  "private": true,
  "description": "FASTFOOD monorepo - commerce and delivery platform (Development-Only / Human-Validation mode).",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.4.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=12.4.0 <13"
  },
  "scripts": {
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf .turbo node_modules",
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "infra:logs": "docker compose -f infrastructure/docker/docker-compose.yml logs -f",
    "infra:ps": "docker compose -f infrastructure/docker/docker-compose.yml ps",
    "dev:stack:up": "bash scripts/dev-stack-up.sh",
    "dev:stack:down": "bash scripts/dev-stack-down.sh",
    "db:migrate": "pnpm --filter @fastfood/api exec prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter @fastfood/api exec prisma migrate deploy",
    "db:generate": "pnpm --filter @fastfood/api exec prisma generate",
    "keys:dev": "node scripts/generate-dev-jwt-keys.mjs",
    "db:validate": "pnpm --filter @fastfood/api exec prisma validate",
    "db:seed": "pnpm --filter @fastfood/api exec prisma db seed",
    "db:reset": "pnpm --filter @fastfood/api exec prisma migrate reset --force",
    "dev:api": "pnpm --filter @fastfood/api start",
    "dev:storefront": "pnpm --filter @fastfood/storefront-web start",
    "dev:admin": "pnpm --filter @fastfood/admin-web start",
    "dev:admin:watch": "bash scripts/dev-admin-watch.sh",
    "dev:storefront:watch": "bash scripts/dev-frontend-watch.sh storefront",
    "dev:qr:watch": "bash scripts/dev-frontend-watch.sh qr",
    "dev:api:watch": "bash scripts/dev-frontend-watch.sh api",
    "dev:full:watch": "bash scripts/dev-frontend-watch.sh api & bash scripts/dev-frontend-watch.sh storefront & bash scripts/dev-admin-watch.sh",
    "e2e:web": "pnpm --filter @fastfood/e2e-web exec playwright test",
    "e2e:web:install": "pnpm --filter @fastfood/e2e-web exec playwright install --with-deps chromium",
    "e2e:web:local": "pnpm build && pnpm e2e:web",
    "controller:status": "pnpm --filter @fastfood/dev-controller exec tsx src/cli.ts status",
    "controller:validate": "pnpm --filter @fastfood/dev-controller exec tsx src/cli.ts validate",
    "controller:init": "pnpm --filter @fastfood/dev-controller exec tsx src/cli.ts init",
    "controller:begin": "pnpm --filter @fastfood/dev-controller exec tsx src/cli.ts begin",
    "controller:verify": "pnpm --filter @fastfood/dev-controller exec tsx src/cli.ts verify",
    "controller:repair": "pnpm --filter @fastfood/dev-controller exec tsx src/cli.ts repair",
    "controller:complete": "pnpm --filter @fastfood/dev-controller exec tsx src/cli.ts complete",
    "controller:block": "pnpm --filter @fastfood/dev-controller exec tsx src/cli.ts block",
    "controller:checkpoint": "pnpm --filter @fastfood/dev-controller exec tsx src/cli.ts checkpoint",
    "controller:advance": "pnpm --filter @fastfood/dev-controller exec tsx src/cli.ts advance",
    "controller:release": "pnpm --filter @fastfood/dev-controller exec tsx src/cli.ts release",
    "controller:transition-to-phase": "pnpm --filter @fastfood/dev-controller exec tsx src/cli.ts transition-to-phase",
    "customer-ui:sync:plan": "node scripts/customer-ui-sync-check.mjs",
    "controller:test": "pnpm --filter @fastfood/dev-controller test:unit",
    "check:customer-platform": "pnpm --filter @fastfood/contracts build && pnpm --filter @fastfood/contracts typecheck && pnpm --filter @fastfood/contracts run check:customer-platform && pnpm --filter @fastfood/storefront-web typecheck && pnpm --filter @fastfood/customer-mobile typecheck"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "eslint": "9.18.0",
    "prettier": "3.4.2",
    "turbo": "2.10.4",
    "typescript": "5.9.3"
  },
  "volta": {
    "node": "24.21.0"
  }
}
