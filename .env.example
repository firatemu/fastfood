# =====================================================================
# FASTFOOD — Development environment configuration template
# Copy this file to .env and fill values for your local machine.
# NEVER commit a real .env. NEVER place secrets in source control.
# All values below are development-only defaults. No production
# credentials, providers, domains, or TLS configuration belong here.
# =====================================================================

# --- Node / runtime ---
NODE_ENV=development
LOG_LEVEL=debug
APP_TIMEZONE=Europe/Istanbul

# --- API ---
API_HOST=0.0.0.0
API_PORT=4000
API_BASE_PATH=/api/v1
API_CORS_ORIGINS=http://localhost:3100,http://localhost:3101,http://localhost:3102,http://localhost:3000,http://localhost:3001
COURIER_WEB_ORIGIN=http://localhost:3102
# Long random secret used to sign request-id/nonce generation helpers.
# DEV ONLY. Replace via env in any non-development environment.
API_DEV_SECRET=change-me-development-only-32-bytes-min

# --- PostgreSQL 18 + PostGIS 3.6 ---
# Matches docker-compose service. Local-only.
DATABASE_URL=postgresql://fastfood:fastfood@localhost:5439/fastfood?schema=public
# Separate URL for the integration test database (created automatically by test harness).
DATABASE_TEST_URL=postgresql://fastfood:fastfood@localhost:5439/fastfood_test?schema=public

# --- Redis 8 ---
REDIS_URL=redis://localhost:6388

# --- MinIO (S3-compatible local object storage) ---
S3_ENDPOINT=http://localhost:9098
S3_PUBLIC_ENDPOINT=http://localhost:9098
S3_REGION=us-east-1
S3_BUCKET=fastfood-dev
S3_ACCESS_KEY=fastfood
S3_SECRET_KEY=fastfood-dev-secret
S3_FORCE_PATH_STYLE=true

# --- iyzico (sandbox ONLY in development) ---
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_API_KEY=replace-with-sandbox-key
IYZICO_SECRET_KEY=replace-with-sandbox-secret
IYZICO_USE_SANDBOX=true

# --- OTP (fake provider in development) ---
OTP_PROVIDER=fake
OTP_FAKE_FIXED_CODE=000000
OTP_TTL_SECONDS=180
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_15_MIN=5

# ADR-010: phone OTP is suspended for customer registration during UI maturation.
# Local dev convenience; production must remain unset / "false".
CUSTOMER_REGISTRATION_OTP_SUSPENDED=true

# --- Customer OAuth (empty = provider shown as unavailable; never fake success) ---
STOREFRONT_PUBLIC_URL=http://localhost:3100
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/auth/customer/oauth/google/callback
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
APPLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/auth/customer/oauth/apple/callback

# --- Maps (Google Maps Platform — dev-restricted key) ---
MAPS_PROVIDER=google
GOOGLE_MAPS_API_KEY=replace-with-dev-key

# --- Auth ---
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_SESSION_TTL_DAYS=30
JWT_ISSUER=fastfood-dev
JWT_AUDIENCE=fastfood-api
# RS256 access-token signing. DEV ONLY private key path.
# Provide a dev keypair via the helper script `pnpm --filter @fastfood/api keys:dev`.
JWT_PRIVATE_KEY_PATH=./secrets/dev/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/dev/jwt-public.pem

# --- Rate limiting ---
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# --- Telemetry / observability ---
OTEL_ENABLED=false

# --- Local Docker ports (for `pnpm infra:up`) ---
FASTFOOD_POSTGRES_PORT=5439
FASTFOOD_REDIS_PORT=6388
FASTFOOD_MINIO_API_PORT=9098
FASTFOOD_MINIO_CONSOLE_PORT=9099

# --- Courier account used by the local development seed ---
SEED_COURIER_IDENTIFIER=courier@example.local
SEED_COURIER_PASSWORD=replace-with-a-local-password
