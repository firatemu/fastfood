# =====================================================================
# FASTFOOD — Coolify environment variables (ADR-021)
# Names only. Enter real values in Coolify > Resource > Environment
# Variables. NEVER commit real values.
#
# Generated automatically by Coolify (do not set by hand):
#   SERVICE_PASSWORD_POSTGRES, SERVICE_PASSWORD_REDIS, SERVICE_PASSWORD_MINIO,
#   SERVICE_PASSWORD_64_APISECRET, SERVICE_PASSWORD_64_OTPPEPPER
# =====================================================================

# --- Public origins (defaults shown; change only if domains change) ---
PUBLIC_API_URL=https://apiburger.azem.cloud
PUBLIC_STOREFRONT_URL=https://burger.azem.cloud
PUBLIC_ADMIN_URL=https://adminburger.azem.cloud
PUBLIC_COURIER_URL=https://kuryeburger.azem.cloud
PUBLIC_QR_URL=https://qrburger.azem.cloud
PUBLIC_MAP_URL=https://mapburger.azem.cloud

# --- RS256 staff access-token keypair (base64 of the PEM files) ---
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
# openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
# base64 -w0 jwt-private.pem ; base64 -w0 jwt-public.pem
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=

# --- iyzico SANDBOX credentials (sandbox-merchant.iyzipay.com) ---
IYZICO_SANDBOX_API_KEY=
IYZICO_SANDBOX_SECRET_KEY=

# --- Maps: "osm" needs no key; "google" needs a key restricted to *.azem.cloud ---
MAPS_PROVIDER=osm
GOOGLE_MAPS_API_KEY=

# --- Optional customer OAuth (empty = provider shown as unavailable) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

LOG_LEVEL=info
S3_BUCKET=fastfood
