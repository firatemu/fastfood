# pnpm runtime configuration. Only knobs that the pnpm CLI does NOT support
# in `pnpm-workspace.yaml` live here (e.g. `auto-install-peers`,
# `strict-peer-dependencies`, `shamefully-hoist`). Build-script allow-lists,
# `minimumReleaseAge`, and `nodeLinker` are all set in `pnpm-workspace.yaml`
# so there is one canonical source of truth.

auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=true
