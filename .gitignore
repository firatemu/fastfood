.fastfood-controller/

# Local dev stack (nohup PIDs + logs)
.fastfood-dev/

# Test
coverage/
.nyc_output/
playwright-report/
test-results/
.playwright/
.maestro-logs/

# Env / secrets
.env
.env.local
.env.*.local
.envrc

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
