.cursor/
*.swp

# Prisma local artifacts (migrations tracked; local dev DB excluded)
*.db
*.sqlite
*.sqlite3
prisma/dev.db*

# Docker
.docker/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Stitch browser OAuth profile (local only)
apps/storefront-web/.stitch/browser-profile/

# Prisma generated client — custom generator output, not source.
# Regenerate with `pnpm db:generate`. CI runs that step before typecheck
# because `apps/api/src` imports types from this output.
apps/api/prisma/generated/

# Local development JWT signing keys. A private signing key must never enter
# source control (AGENTS.md §8). Regenerate with `pnpm keys:dev`.
/apps/api/secrets/

# Stitch generated exports — regenerable through the storefront `stitch:*`
# scripts. `.stitch/README.md`, `.stitch/DESIGN.md` and the browser-profile
# rules above remain tracked because they are the visual source of truth.
apps/storefront-web/.stitch/export/
apps/storefront-web/.stitch-html/

# Local PostgreSQL snapshots (`pg_dump` output). They can contain credential
# hashes, refresh-token hashes and other row data, so they stay local only.
/backups/*.dump

# Stray nested copy created by writing through a `\\wsl.localhost\...` path.
/wsl.localhost/
