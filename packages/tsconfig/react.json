{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Fastfood React Web",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  }
}
